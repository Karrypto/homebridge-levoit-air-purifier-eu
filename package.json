{
  "description": "Homebridge plugin for Levoit Air Purifiers (Core 200S/300S/400S/600S) with EU support",
  "name": "homebridge-levoit-air-purifier-eu",
  "displayName": "Levoit Air Purifier EU",
  "main": "dist/index.js",
  "files": [
    "dist",
    "config.schema.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "license": "Apache-2.0",
  "version": "1.2.3",
  "private": false,
  "bugs": {
    "url": "https://github.com/Karrypto/homebridge-levoit-air-purifier-eu/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Karrypto/homebridge-levoit-air-purifier-eu.git"
  },
  "changelog": "https://github.com/Karrypto/homebridge-levoit-air-purifier-eu/blob/master/CHANGELOG.md",
  "scripts": {
    "prepublishOnly": "npm run check",
    "lint": "eslint \"src/**/*.ts\" --max-warnings=0",
    "typecheck": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "build": "rimraf ./dist && tsc",
    "test": "node --test \"test/**/*.test.js\"",
    "check": "npm run lint && npm run typecheck && npm run build && npm test && npm audit && npm pack --dry-run"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/async-lock": "^1.4.2",
    "@types/node": "^24.13.1",
    "eslint": "^9.39.4",
    "homebridge": "^1.11.4",
    "rimraf": "^6.1.3",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.60.1"
  },
  "engines": {
    "homebridge": ">=1.3.5 || ^2.0.0-beta.0",
    "node": ">=22"
  },
  "dependencies": {
    "async-lock": "^1.4.1",
    "axios": "^1.17.0"
  },
  "keywords": [
    "homebridge-plugin",
    "air-purifier",
    "400s Pro",
    "vesync",
    "levoit",
    "200s",
    "300s",
    "400s",
    "600s"
  ]
}
